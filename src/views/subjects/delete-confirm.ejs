<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="page-head">
  <div>
    <h1 class="page-title"><%= page.heading %></h1>
    <p class="page-description">确认删除前的完整影响范围。</p>
  </div>
</section>

<%- include('../partials/flash') %>

<section class="card">
  <h2 class="card-title">即将删除的科目</h2>
  <dl class="detail-grid">
    <div class="detail-item">
      <dt>科目名称</dt>
      <dd class="detail-strong"><%= target.name %></dd>
    </div>
    <div class="detail-item">
      <dt>关联成绩记录</dt>
      <dd class="detail-strong"><%= scoreCount %> 条</dd>
    </div>
  </dl>

  <% if (!canDelete) { %>
    <div class="alert alert--danger">
      无法删除科目：该科目已包含 <%= scoreCount %> 条成绩记录。为防止历史成绩脱靶，已有关联成绩的科目禁止删除；如需调整，可直接编辑科目名称。
    </div>
    <div class="form-actions">
      <a class="btn btn--primary" href="/subjects/<%= target.id %>/edit">编辑科目名称</a>
      <a class="btn btn--secondary" href="/subjects">返回科目列表</a>
    </div>
  <% } else { %>
    <div class="alert alert--danger">
      此操作不可撤销：删除后科目记录将永久消失，取消则不会写入任何修改。
    </div>
    <div class="form-actions">
      <form method="post" action="/subjects/<%= target.id %>/delete">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--danger" type="submit">确认删除该科目</button>
      </form>
      <a class="btn btn--secondary" href="/subjects">取消并返回</a>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
