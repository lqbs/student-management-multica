<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="page-head">
  <div>
    <h1 class="page-title"><%= page.heading %></h1>
    <p class="page-description">确认删除前的完整影响范围。</p>
  </div>
</section>

<%- include('../partials/flash') %>

<section class="card">
  <h2 class="card-title">即将删除的成绩</h2>
  <dl class="detail-grid">
    <div class="detail-item">
      <dt>学生</dt>
      <dd class="detail-strong"><%= target.student_name %>（学号 <span class="font-mono"><%= target.student_no %></span>）</dd>
    </div>
    <div class="detail-item">
      <dt>科目</dt>
      <dd class="detail-strong"><%= target.subject_name %></dd>
    </div>
    <div class="detail-item">
      <dt>分数</dt>
      <dd class="detail-strong"><%= formatScore(target.score_tenths) %></dd>
    </div>
  </dl>

  <div class="alert alert--danger">
    此操作不可撤销：删除后该条成绩将永久消失，学生的其它成绩不受影响，取消则不会写入任何修改。
  </div>

  <div class="form-actions">
    <form method="post" action="/scores/<%= target.id %>/delete">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn--danger" type="submit">确认删除该成绩</button>
    </form>
    <a class="btn btn--secondary" href="/scores">取消并返回</a>
  </div>
</section>

<%- include('../partials/footer') %>
