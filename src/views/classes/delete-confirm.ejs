<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="page-head">
  <div>
    <h1 class="page-title"><%= page.heading %></h1>
    <p class="page-description">确认删除前的完整影响范围。</p>
  </div>
</section>

<%- include('../partials/flash') %>

<section class="card">
  <h2 class="card-title">即将删除的班级</h2>
  <dl class="detail-grid">
    <div class="detail-item">
      <dt>班级名称</dt>
      <dd class="detail-strong"><%= target.name %></dd>
    </div>
    <div class="detail-item">
      <dt>在读学生人数</dt>
      <dd class="detail-strong"><%= studentCount %> 人</dd>
    </div>
    <div class="detail-item">
      <dt>创建时间</dt>
      <dd class="text-muted"><%= formatDateTime(target.created_at) %></dd>
    </div>
  </dl>

  <% if (!canDelete) { %>
    <div class="alert alert--danger">
      无法删除该班级：该班级目前共有 <%= studentCount %> 名学生，请先在学生档案中将学生转入其他班级或设为“未分班”后再删除。
    </div>
    <div class="form-actions">
      <a class="btn btn--primary" href="/students?classId=<%= target.id %>">前往学生档案转班</a>
      <a class="btn btn--secondary" href="/classes">返回班级列表</a>
    </div>
  <% } else { %>
    <div class="alert alert--danger">
      此操作不可撤销：删除后班级记录将永久消失，取消则不会写入任何修改。
    </div>
    <div class="form-actions">
      <form method="post" action="/classes/<%= target.id %>/delete">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--danger" type="submit">确认删除该班级</button>
      </form>
      <a class="btn btn--secondary" href="/classes">取消并返回</a>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
