<div class="modal" id="confirm-modal" hidden>
  <div class="modal-backdrop" data-modal-cancel></div>
  <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
    <h2 class="modal-title" id="confirm-modal-title">确认操作</h2>
    <p class="modal-body" id="confirm-modal-warning">该操作不可撤销，是否继续？</p>
    <form method="post" id="confirm-modal-form" action="">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-actions">
        <button type="button" class="btn btn--secondary" data-modal-cancel>取消</button>
        <button type="submit" class="btn btn--danger" id="confirm-modal-submit">确认删除</button>
      </div>
    </form>
  </div>
</div>

